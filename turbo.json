{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", "tsconfig.json"],
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "API_URL",
    "INTERNAL_API_URL",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "MSG91_AUTH_KEY",
    "MSG91_SENDER_ID",
    "MSG91_TEMPLATE_OTP",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "SELLER_GSTIN",
    "SELLER_LEGAL_NAME",
    "SELLER_STATE_CODE",
    "SELLER_ADDRESS_JSON",
    "IRP_BASE_URL",
    "IRP_USERNAME",
    "IRP_PASSWORD",
    "IRP_CLIENT_ID",
    "IRP_CLIENT_SECRET",
    "CPPP_RSS_URL",
    "TENDER_INBOX_HOST",
    "TENDER_INBOX_USER",
    "TENDER_INBOX_PASS",
    "ADMIN_IP_ALLOWLIST",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
