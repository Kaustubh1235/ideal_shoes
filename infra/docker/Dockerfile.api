# =============================================================================
# FastAPI + Celery worker image. Includes WeasyPrint system deps for PDF gen.
# =============================================================================
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_VIRTUALENVS_CREATE=false

# System deps: WeasyPrint needs cairo/pango; curl for healthchecks; postgresql client libs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    libcairo2 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-liberation \
    fonts-noto \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy pyproject and install deps first (layer caching). Non-editable, so the image does not
# depend on a bind mount; the dev compose mounts the source over /app and still works.
COPY apps/api/pyproject.toml ./
RUN pip install --upgrade pip && \
    python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); print('\n'.join(d['project']['dependencies']))" > /tmp/req.txt && \
    pip install -r /tmp/req.txt

# Copy source
COPY apps/api/ ./
COPY scripts/seed_admin.py ./scripts/seed_admin.py

RUN useradd --system --uid 1001 --home /app api && chown -R api /app
USER api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
