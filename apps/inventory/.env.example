# Stock Room — copy to .env and fill in.

# The address phones will open. Needs a DNS A record pointing at this machine for a public certificate.
# For a shop PC on the local network only, use its Tailscale name, or leave "localhost" and install Caddy's local CA on each phone once.
DOMAIN=stock.idealx.in

# Optional. Leave empty and the app generates one on first start and keeps it in the data volume.
# Set it only if you want to control it (at least 32 characters).
APP_SECRET=

# Optional. If set, GET /metrics needs "Authorization: Bearer <token>".
METRICS_TOKEN=

# Shown at the top of the app. scripts/update.sh sets it to <version>+<git commit>; no need to set it here.
# APP_VERSION=
