{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@bharatboot/db": [
        "../../packages/db/src/index.ts"
      ],
      "@bharatboot/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@bharatboot/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@bharatboot/types": [
        "../../packages/types/src/index.ts"
      ],
      "@bharatboot/types/*": [
        "../../packages/types/src/*"
      ],
      "@bharatboot/gst": [
        "../../packages/gst/src/index.ts"
      ]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
