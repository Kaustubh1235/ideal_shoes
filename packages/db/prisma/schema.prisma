// =========================================================================
// Prisma schema for BharatBoot
//
// DDL OWNERSHIP: Alembic (apps/api/alembic) is the source of truth.
// Regenerate this file by running: pnpm prisma:pull
// Do NOT edit this file by hand -- changes will be overwritten on next pull.
// =========================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  customer
  dealer
  staff

  @@map("user_type")
}

enum StaffRole {
  super_admin
  admin
  ops
  finance
  support

  @@map("staff_role")
}

enum DealerStatus {
  pending
  approved
  suspended
  rejected

  @@map("dealer_status")
}

enum DealerGstScheme {
  regular
  composition
  unregistered

  @@map("dealer_gst_scheme")
}

enum OrderChannel {
  d2c
  wholesale
  manual
  tender

  @@map("order_channel")
}

enum OrderStatus {
  draft
  pending_payment
  paid
  processing
  packed
  shipped
  delivered
  cancelled
  returned
  refunded

  @@map("order_status")
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum TaxTreatment {
  TAXABLE
  EXEMPT
  NIL_RATED
  ZERO_RATED
  NON_GST

  @@map("tax_treatment")
}

enum AddressType {
  billing
  shipping
  both

  @@map("address_type")
}

enum StockMovementReason {
  purchase
  sale
  return_in
  adjustment
  transfer_in
  transfer_out
  production
  damage
  reserve
  release

  @@map("stock_movement_reason")
}

enum TenderSource {
  manual
  rss_cppp
  email
  aggregator_bidassist
  aggregator_tendersinfo

  @@map("tender_source")
}

enum TenderStatus {
  new
  watching
  preparing_bid
  submitted
  won
  lost
  withdrawn
  expired

  @@map("tender_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?  @map("password_hash")
  userType     UserType @map("user_type")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer  CustomerProfile?
  dealer    DealerProfile?
  staff     StaffProfile?
  addresses Address[]
  orders    Order[]          @relation("OrderUser")
  sessions  Session[]
  carts     Cart[]
  auditLogs AuditLog[]       @relation("ActorUser")

  @@map("users")
  @@index([userType])
}

model CustomerProfile {
  userId            String   @id @map("user_id") @db.Uuid
  name              String
  dob               DateTime?
  defaultAddressId  String?  @map("default_address_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DealerProfile {
  userId                       String          @id @map("user_id") @db.Uuid
  businessName                 String          @map("business_name")
  gstin                        String          @unique
  pan                          String
  gstScheme                    DealerGstScheme @default(regular) @map("gst_scheme")
  status                       DealerStatus    @default(pending)
  priceTier                    String          @default("tier_b") @map("price_tier")
  creditLimit                  Int             @default(0) @map("credit_limit")
  creditUsed                   Int             @default(0) @map("credit_used")
  paymentTermsDays             Int             @default(0) @map("payment_terms_days")
  yearsInBusiness              Int?            @map("years_in_business")
  estimatedMonthlyOrderValue   Int?            @map("estimated_monthly_order_value")
  approvedAt                   DateTime?       @map("approved_at")
  approvedBy                   String?         @map("approved_by") @db.Uuid
  rejectionReason              String?         @map("rejection_reason")
  createdAt                    DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dealer_profiles")
  @@index([status])
}

model StaffProfile {
  userId         String    @id @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  role           StaffRole
  totpSecret     String?   @map("totp_secret")
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  ipAllowlist    String?   @map("ip_allowlist")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jti       String   @unique
  ip        String?
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String   @map("code_hash")
  purpose   String
  attempts  Int      @default(0)
  consumedAt DateTime? @map("consumed_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
  @@index([phone, purpose])
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  fullName   String      @map("full_name")
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  stateCode  String      @map("state_code")
  pincode    String
  country    String      @default("India")
  landmark   String?
  type       AddressType @default(both)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("addresses")
  @@index([userId])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  gstin     String?
  addressId String?  @map("address_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  inventory        Inventory[]
  stockMovements   StockMovement[]
  shipments        Shipment[]

  @@map("warehouses")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@map("categories")
}

model Product {
  id               String       @id @default(uuid()) @db.Uuid
  sku              String       @unique
  slug             String       @unique
  name             String
  shortDescription String?      @map("short_description")
  description      String?
  categoryId       String?      @map("category_id") @db.Uuid
  hsnCode          String       @map("hsn_code")
  taxTreatment     TaxTreatment @default(TAXABLE) @map("tax_treatment")
  basePrice        Int          @map("base_price")
  mrp              Int?
  status           String       @default("draft")
  arEnabled        Boolean      @default(false) @map("ar_enabled")
  arModelUrl       String?      @map("ar_model_url")
  weightGrams      Int?         @map("weight_grams")
  metaJson         Json?        @map("meta_json")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@map("products")
  @@index([status])
  @@index([categoryId])
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique
  size          String
  color         String
  attributes    Json?
  priceOverride Int?     @map("price_override")
  weightGrams   Int?     @map("weight_grams")
  barcode       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  images         ProductImage[]

  @@map("product_variants")
  @@index([productId])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  url        String
  alt        String?
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("product_images")
}

model Inventory {
  variantId     String   @id @map("variant_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  onHand        Int      @default(0) @map("on_hand")
  reserved      Int      @default(0) @map("reserved")
  reorderPoint  Int      @default(0) @map("reorder_point")
  updatedAt     DateTime @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@map("inventory")
}

model StockMovement {
  id          String              @id @default(uuid()) @db.Uuid
  variantId   String              @map("variant_id") @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  delta       Int
  reason      StockMovementReason
  refType     String?             @map("ref_type")
  refId       String?             @map("ref_id") @db.Uuid
  note        String?
  createdBy   String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@map("stock_movements")
  @@index([variantId, createdAt])
  @@index([refType, refId])
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  anonToken String?  @unique @map("anon_token")
  channel   OrderChannel @default(d2c)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  priceSnapshot Int      @map("price_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("cart_items")
  @@unique([cartId, variantId])
}

model Order {
  id                  String       @id @default(uuid()) @db.Uuid
  orderNo             String       @unique @map("order_no")
  userId              String?      @map("user_id") @db.Uuid
  channel             OrderChannel
  status              OrderStatus  @default(draft)
  billingAddressId    String?      @map("billing_address_id") @db.Uuid
  shippingAddressId   String?      @map("shipping_address_id") @db.Uuid
  buyerGstin          String?      @map("buyer_gstin")
  buyerLegalName      String?      @map("buyer_legal_name")
  contactEmail        String?      @map("contact_email")
  placeOfSupply       String?      @map("place_of_supply") // 2-digit state code
  reverseCharge       Boolean      @default(false) @map("reverse_charge")
  subtotal            Int          @default(0)
  taxableValue        Int          @default(0) @map("taxable_value")
  cgstTotal           Int          @default(0) @map("cgst_total")
  sgstTotal           Int          @default(0) @map("sgst_total")
  igstTotal           Int          @default(0) @map("igst_total")
  cessTotal           Int          @default(0) @map("cess_total")
  shippingTotal       Int          @default(0) @map("shipping_total")
  discountTotal       Int          @default(0) @map("discount_total")
  roundOff            Int          @default(0) @map("round_off")
  grandTotal          Int          @default(0) @map("grand_total")
  notes               String?
  placedAt            DateTime?    @map("placed_at")
  paidAt              DateTime?    @map("paid_at")
  shippedAt           DateTime?    @map("shipped_at")
  deliveredAt         DateTime?    @map("delivered_at")
  cancelledAt         DateTime?    @map("cancelled_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user      User?       @relation("OrderUser", fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  invoices  Invoice[]
  shipments Shipment[]
  returns   ReturnRequest[]

  @@map("orders")
  @@index([userId])
  @@index([status])
  @@index([channel, createdAt])
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  sku           String
  name          String
  hsnCode       String   @map("hsn_code")
  quantity      Int
  unitPrice     Int      @map("unit_price")
  discount      Int      @default(0)
  taxableValue  Int      @map("taxable_value")
  gstRate       Float    @map("gst_rate")
  cgst          Int      @default(0)
  sgst          Int      @default(0)
  igst          Int      @default(0)
  cess          Int      @default(0)
  lineTotal     Int      @map("line_total")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  gateway           String        @default("razorpay")
  gatewayOrderId    String?       @map("gateway_order_id")
  gatewayPaymentId  String?       @map("gateway_payment_id")
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(created)
  method            String?
  rawPayload        Json?         @map("raw_payload")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@map("payments")
  @@index([orderId])
  @@index([gatewayOrderId])
}

model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String?  @map("payment_id") @db.Uuid
  gateway     String   @default("razorpay")
  eventType   String   @map("event_type")
  eventId     String?  @unique @map("event_id")
  signature   String?
  raw         Json
  receivedAt  DateTime @default(now()) @map("received_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("payment_events")
  @@index([gateway, eventType])
}

model IdempotencyKey {
  key          String   @id
  scope        String
  requestHash  String   @map("request_hash")
  responseJson Json?    @map("response_json")
  status       String   @default("processing")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@map("idempotency_keys")
  @@index([expiresAt])
}

model InvoiceSeries {
  code           String @id // e.g., "BBT-D2C", "BBT-B2B"
  financialYear  String @map("financial_year")
  prefix         String
  nextNumber     Int    @default(1) @map("next_number")

  @@unique([code, financialYear])
  @@map("invoice_series")
}

model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceNo       String   @unique @map("invoice_no")
  seriesCode      String   @map("series_code")
  financialYear   String   @map("financial_year")
  orderId         String   @map("order_id") @db.Uuid
  buyerGstin      String?  @map("buyer_gstin")
  placeOfSupply   String   @map("place_of_supply")
  reverseCharge   Boolean  @default(false) @map("reverse_charge")
  taxableValue    Int      @map("taxable_value")
  cgstTotal       Int      @map("cgst_total")
  sgstTotal       Int      @map("sgst_total")
  igstTotal       Int      @map("igst_total")
  cessTotal       Int      @map("cess_total")
  roundOff        Int      @map("round_off")
  grandTotal      Int      @map("grand_total")
  amountInWords   String   @map("amount_in_words")
  pdfUrl          String?  @map("pdf_url")
  irn             String?  @unique
  ackNo           String?  @map("ack_no")
  ackDate         DateTime? @map("ack_date")
  signedQr        String?  @map("signed_qr")
  irpStatus       String?  @map("irp_status")
  issuedAt        DateTime @default(now()) @map("issued_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?  @map("cancel_reason")

  order       Order        @relation(fields: [orderId], references: [id])
  creditNotes CreditNote[]

  @@map("invoices")
  @@index([financialYear, seriesCode])
}

model CreditNote {
  id              String   @id @default(uuid()) @db.Uuid
  cnNo            String   @unique @map("cn_no")
  invoiceId       String   @map("invoice_id") @db.Uuid
  reason          String
  taxableValue    Int      @map("taxable_value")
  cgstTotal       Int      @map("cgst_total")
  sgstTotal       Int      @map("sgst_total")
  igstTotal       Int      @map("igst_total")
  amount          Int
  pdfUrl          String?  @map("pdf_url")
  issuedAt        DateTime @default(now()) @map("issued_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("credit_notes")
}

model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  courier        String?
  awb            String?
  ewayBillNo     String?   @map("eway_bill_no")
  ewayBillValidUntil DateTime? @map("eway_bill_valid_until")
  status         String    @default("created")
  trackingUrl    String?   @map("tracking_url")
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@map("shipments")
  @@index([orderId])
}

model ReturnRequest {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  reason      String
  status      String   @default("requested")
  itemsJson   Json     @map("items_json")
  refundAmount Int     @default(0) @map("refund_amount")
  approvedAt  DateTime? @map("approved_at")
  receivedAt  DateTime? @map("received_at")
  refundedAt  DateTime? @map("refunded_at")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("return_requests")
}

model DealerPriceList {
  id        String   @id @default(uuid()) @db.Uuid
  tier      String   @unique // tier_a, tier_b, tier_c
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  entries DealerPriceListEntry[]

  @@map("dealer_price_lists")
}

model DealerPriceListEntry {
  id           String   @id @default(uuid()) @db.Uuid
  priceListId  String   @map("price_list_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  price        Int
  minQuantity  Int      @default(1) @map("min_quantity")
  createdAt    DateTime @default(now()) @map("created_at")

  priceList DealerPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@map("dealer_price_list_entries")
  @@unique([priceListId, variantId, minQuantity])
}

model Quote {
  id              String   @id @default(uuid()) @db.Uuid
  quoteNo         String   @unique @map("quote_no")
  dealerId        String   @map("dealer_id") @db.Uuid
  validUntil      DateTime @map("valid_until")
  status          String   @default("draft")
  itemsJson       Json     @map("items_json")
  subtotal        Int
  taxTotal        Int      @map("tax_total")
  grandTotal      Int      @map("grand_total")
  notes           String?
  convertedOrderId String? @map("converted_order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("quotes")
}

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  poNo        String   @unique @map("po_no")
  supplierId  String   @map("supplier_id") @db.Uuid
  status      String   @default("draft")
  itemsJson   Json     @map("items_json")
  subtotal    Int
  taxTotal    Int      @map("tax_total")
  grandTotal  Int      @map("grand_total")
  expectedAt  DateTime? @map("expected_at")
  receivedAt  DateTime? @map("received_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  gstin       String?
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  addressJson Json?    @map("address_json")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  pos PurchaseOrder[]

  @@map("suppliers")
}

model Tender {
  id                 String       @id @default(uuid()) @db.Uuid
  source             TenderSource
  externalId         String?      @map("external_id")
  title              String
  buyerOrg           String       @map("buyer_org")
  description        String?
  publishedAt        DateTime?    @map("published_at")
  submissionDeadline DateTime?    @map("submission_deadline")
  openingDate        DateTime?    @map("opening_date")
  estimatedValue     Float?       @map("estimated_value")
  emd                Float?
  category           String?
  productMatch       String[]     @map("product_match")
  url                String?
  documentUrls       String[]     @map("document_urls")
  rawPayload         Json?        @map("raw_payload")
  status             TenderStatus @default(new)
  assignedTo         String?      @map("assigned_to") @db.Uuid
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("tenders")
  @@index([status])
  @@index([source])
  @@unique([source, externalId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorUser", fields: [actorUserId], references: [id])

  @@map("audit_log")
  @@index([entityType, entityId])
  @@index([actorUserId])
}

model GstrExportRun {
  id           String   @id @default(uuid()) @db.Uuid
  reportType   String   @map("report_type") // GSTR1, GSTR3B, HSN_SUMMARY
  periodMonth  String   @map("period_month") // YYYY-MM
  status       String   @default("pending")
  fileUrl      String?  @map("file_url")
  rowCount     Int?     @map("row_count")
  error        String?
  startedAt    DateTime @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  @@map("gstr_export_runs")
  @@unique([reportType, periodMonth])
}
