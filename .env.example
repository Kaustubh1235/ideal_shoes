# =========================================================================
# IDEALX (Ideal Shoes, Agra) — environment variables
# Copy to `.env` and fill in. Anything left blank uses dev fallbacks.
# =========================================================================

NODE_ENV=development

# ---- Core infra -----------------------------------------------------------
DATABASE_URL=postgresql://bharatboot:devpass@postgres:5432/bharatboot
REDIS_URL=redis://redis:6379/0

# ---- Auth.js v5 -----------------------------------------------------------
# Generate via: openssl rand -hex 32
AUTH_SECRET=replace-me-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3000
# Shared with FastAPI to verify JWTs
JWT_AUDIENCE=bharatboot
JWT_ISSUER=bharatboot-auth

# Admin hardening
ADMIN_IP_ALLOWLIST=                       # comma-separated CIDR, empty = allow all (dev)
ADMIN_TOTP_ISSUER=IDEALX

# ---- Inter-service URLs ---------------------------------------------------
API_URL=http://localhost:8000             # FastAPI public URL (browser-visible)
INTERNAL_API_URL=http://api:8000          # FastAPI internal URL (server-to-server inside docker)
WEB_URL=http://localhost:3000

# ---- Razorpay (placeholder — fill when account exists) --------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS / Phone OTP (placeholder) ----------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BHRTBT
MSG91_TEMPLATE_OTP=
# Set to "true" to log OTPs to console instead of sending (dev)
OTP_DEV_MODE=true

# ---- Object storage (local = minio, prod = S3 / R2) -----------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=bharatboot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# ---- Email (local = mailhog, prod = real SMTP) ----------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bharatboot.local
SMTP_TLS=false

# ---- Seller GST identity (fill from your business registration) -----------
SELLER_GSTIN=
SELLER_LEGAL_NAME=Ideal Shoes
SELLER_TRADE_NAME=IDEALX
SELLER_STATE_CODE=09                          # 09 = Uttar Pradesh
SELLER_ADDRESS_JSON={"line1":"","line2":"","city":"Agra","state":"Uttar Pradesh","pincode":"","country":"India"}
SELLER_EMAIL=
SELLER_PHONE=
SELLER_FINANCIAL_YEAR=2025-26

# ---- Storefront content ---------------------------------------------------
# Public URL of the home-page hero photo (a boot on the last, factory behind). Empty = placeholder.
NEXT_PUBLIC_HERO_IMAGE_URL=

# ---- Inventory app (the separate, self-hosted stock system) ---------------
# The site's only link to it. Leave blank to run without stock sync.
INVENTORY_API_URL=                            # e.g. https://stock.idealx.in
INVENTORY_API_KEY=                            # Admin → API keys in the inventory app (scopes: read, write)
INVENTORY_APP_URL=                            # Same host, used for the "Stock room" link in /admin

# ---- E-invoicing (NIC IRP — gated on GSP onboarding) ----------------------
IRP_ENABLED=false
IRP_BASE_URL=https://einv-apisandbox.nic.in
IRP_USERNAME=
IRP_PASSWORD=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=

# ---- E-way bill (NIC EWB — same GSP onboarding) ---------------------------
EWB_ENABLED=false
EWB_BASE_URL=https://api-sandbox.ewaybillgst.gov.in
EWB_USERNAME=
EWB_PASSWORD=

# ---- Tender ingestion -----------------------------------------------------
CPPP_RSS_URL=https://eprocure.gov.in/cppp/rss/govtprocurement_rss.xml
CPPP_POLL_CRON=0 */6 * * *                # every 6 hours
TENDER_INBOX_HOST=
TENDER_INBOX_PORT=993
TENDER_INBOX_USER=
TENDER_INBOX_PASS=
TENDER_INBOX_TLS=true

# ---- Shipping (Shiprocket / Delhivery — placeholder) ----------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=

# ---- WhatsApp Business API (Meta — placeholder) ---------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- Observability / misc -------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
RATE_LIMIT_PER_MIN=120
