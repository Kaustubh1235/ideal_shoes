# =========================================================================
# IDEALX production settings: the shop (idealx.in) and Stock Room (stock.idealx.in).
#
#   sh scripts/prod.sh init     creates .env from this file with fresh random secrets
#   nano .env                   then fill in the domains and anything you have accounts for
#
# Never commit .env. Every line marked "optional" can stay blank: the feature is simply off
# (payments show "not configured", SMS login is refused, WhatsApp/e-invoice/stock sync log a
# skip) and nothing crashes. Lines marked "secret" are filled in by `init`.
# =========================================================================

# ---- Domains (required) --------------------------------------------------
# DNS A records for both, plus www.<SITE_DOMAIN>, must point at this server.
SITE_DOMAIN=idealx.in
STOCK_DOMAIN=stock.idealx.in

# ---- Secrets (required; `init` generates them) ----------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Signs logins on the site; shared by the website and the API. Changing it signs everyone out.
AUTH_SECRET=
# Object storage (SeaweedFS in this stack) keys.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Stock Room: keeps staff signed in and the AI key readable across restarts and moves.
STOCK_APP_SECRET=
# Optional: protects Stock Room's /metrics.
STOCK_METRICS_TOKEN=

# ---- Storage buckets (defaults are fine) ----------------------------------
S3_BUCKET=media
S3_PRIVATE_BUCKET=private
S3_REGION=us-east-1

# ---- Admin hardening -------------------------------------------------------
# Optional. Comma-separated addresses or IPv4 CIDRs allowed to open /admin; blank = anyone
# who can sign in with password + authenticator code.
ADMIN_IP_ALLOWLIST=
# Name shown in the authenticator app next to the admin's code.
ADMIN_TOTP_ISSUER=IDEALX
# Shown on the Terms page as the grievance officer (Consumer Protection (E-Commerce) Rules, 2020).
GRIEVANCE_OFFICER=
JWT_AUDIENCE=bharatboot
JWT_ISSUER=bharatboot-auth

# ---- Razorpay (optional until KYC is done; checkout cannot take money without it) -------
# Dashboard -> Settings -> API Keys. Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks, URL https://<SITE_DOMAIN>/api/v1/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS OTP login via MSG91 (optional; phone login is refused until set) ----
MSG91_AUTH_KEY=
MSG91_SENDER_ID=IDEALX
MSG91_TEMPLATE_OTP=

# ---- Email (optional; order mails are skipped until set) -------------------
# Any SMTP account: Google Workspace (smtp.gmail.com, 587, an app password), Zoho, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IDEALX <orders@idealx.in>
SMTP_TLS=true

# ---- WhatsApp Business via Meta Cloud API (optional) -----------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Reserved for inbound webhooks; unused today.
WHATSAPP_VERIFY_TOKEN=

# ---- Seller GST identity (fill before the first real order) ----------------
SELLER_GSTIN=
SELLER_LEGAL_NAME=Ideal Shoes
SELLER_TRADE_NAME=IDEALX
SELLER_STATE_CODE=09
SELLER_ADDRESS_JSON={"line1":"","line2":"","city":"Agra","state":"Uttar Pradesh","pincode":"","country":"India"}
SELLER_EMAIL=
SELLER_PHONE=
# Invoice numbering year; change every 1 April.
SELLER_FINANCIAL_YEAR=2026-27

# ---- Stock Room link (optional until you create the key) -------------------
# Stock Room -> Admin -> API keys -> name "Website", Read + write. The site syncs stock every
# 15 minutes and records web sales there. The address is internal; leave it as is.
INVENTORY_API_KEY=
INVENTORY_API_URL=http://inventory:8787

# ---- Storefront ------------------------------------------------------------
# Optional. Public URL of the home-page hero photo; blank shows a placeholder.
NEXT_PUBLIC_HERO_IMAGE_URL=

# ---- E-invoicing / e-way bill (only above Rs 5 crore turnover; needs a GSP) --
IRP_ENABLED=false
IRP_BASE_URL=
IRP_USERNAME=
IRP_PASSWORD=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
EWB_ENABLED=false

# ---- Tenders ---------------------------------------------------------------
CPPP_RSS_URL=https://eprocure.gov.in/cppp/rss/govtprocurement_rss.xml
# Optional IMAP inbox that receives tender mails.
TENDER_INBOX_HOST=
TENDER_INBOX_PORT=993
TENDER_INBOX_USER=
TENDER_INBOX_PASS=
TENDER_INBOX_TLS=true

# ---- Shipping (not wired yet; see docs/GO-LIVE.md section 4) ------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- Operations ------------------------------------------------------------
LOG_LEVEL=info
# Reserved: read by the API settings but no error tracker is wired yet.
SENTRY_DSN=
# Local testing only: publish Caddy on other ports, e.g. 8080/8443.
HTTP_PORT=80
HTTPS_PORT=443
